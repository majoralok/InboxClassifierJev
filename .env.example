# Public origin used for OAuth redirects and same-origin checks.
APP_URL=http://localhost:3000
ALLOWED_GOOGLE_EMAIL=you@example.com

# Google Cloud OAuth 2.0 web application credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Create at https://console.typesafe.ai/keys.
TYPESAFE_API_KEY=replace-with-typesafe-api-key

# Generate each value independently. See README.md for the command.
APP_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key
SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

# Optional settings.
DATABASE_PATH=./data/inbox-classifier.db
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.65
DEFAULT_BATCH_SIZE=25
EMAIL_LOOKBACK_DAYS=30
ENVIRONMENT=development
